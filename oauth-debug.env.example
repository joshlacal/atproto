# ============================================================================
# PDS OAuth Debug Configuration
# Copy this file and customize for your environment
# ============================================================================

# ----------------------------------------------------------------------------
# OAUTH DEBUG LOGGING
# ----------------------------------------------------------------------------
LOG_ENABLED=true
LOG_LEVEL=debug

# OAuth-focused logging subsystems
# - pds:oauth: Core OAuth operations (tokens, DPoP, authentication)
# - pds:fetch: HTTP requests (metadata, scope resolution)
# - pds:db: Database operations (token storage, sessions)
# - pds:lexicon-resolver: Scope validation
LOG_SYSTEMS="pds:oauth pds:fetch pds:db pds:lexicon-resolver"

# Optional: Write logs to file (comment out to use stdout)
# LOG_DESTINATION=/var/log/pds/oauth-debug.log

# ----------------------------------------------------------------------------
# DPOP CONFIGURATION
# ----------------------------------------------------------------------------

# DPoP secret for nonce generation (REQUIRED for DPoP)
# Generate with: openssl rand -hex 32
# MUST be exactly 64 hex characters (32 bytes)
PDS_DPOP_SECRET="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Set to 'false' to disable DPoP nonces (not recommended)
# PDS_DPOP_SECRET=false

# ----------------------------------------------------------------------------
# REQUIRED PDS CONFIGURATION
# ----------------------------------------------------------------------------

# JWT secret for signing tokens
# Generate with: openssl rand -base64 32
PDS_JWT_SECRET="REPLACE_WITH_YOUR_JWT_SECRET"

# Admin password for PDS administration
PDS_ADMIN_PASSWORD="REPLACE_WITH_YOUR_ADMIN_PASSWORD"

# Your PDS hostname (no protocol, no trailing slash)
PDS_HOSTNAME="your-pds.example.com"

# Database connection
PDS_DATA_DIRECTORY="/pds/data"
# Or use Postgres:
# PDS_DB_POSTGRES_URL="postgresql://user:password@localhost:5432/pds"

# ----------------------------------------------------------------------------
# OAUTH CLIENT CONFIGURATION
# ----------------------------------------------------------------------------

# Optional: Trusted OAuth clients (comma or space-separated URLs)
# These clients may receive additional privileges
# PDS_OAUTH_TRUSTED_CLIENTS="https://client1.example.com https://client2.example.com"

# ----------------------------------------------------------------------------
# OAUTH PROVIDER BRANDING (Optional)
# ----------------------------------------------------------------------------

# Customize the OAuth consent/login screens
# PDS_OAUTH_PROVIDER_NAME="My Personal Data Server"
# PDS_OAUTH_PROVIDER_LOGO="https://example.com/logo.png"
# PDS_OAUTH_PROVIDER_PRIMARY_COLOR="#0066cc"
# PDS_OAUTH_PROVIDER_ERROR_COLOR="#cc0000"
# PDS_OAUTH_PROVIDER_HOME_LINK="https://example.com"
# PDS_OAUTH_PROVIDER_TOS_LINK="https://example.com/tos"
# PDS_OAUTH_PROVIDER_POLICY_LINK="https://example.com/privacy"
# PDS_OAUTH_PROVIDER_SUPPORT_LINK="https://example.com/support"

# ----------------------------------------------------------------------------
# REDIS (Recommended for production)
# ----------------------------------------------------------------------------

# Redis for DPoP replay protection and nonce management
# Highly recommended for multi-instance deployments
# PDS_REDIS_SCRATCH_ADDRESS="redis://localhost:6379"

# ----------------------------------------------------------------------------
# ADDITIONAL SETTINGS
# ----------------------------------------------------------------------------

# Service DID (auto-generated if not set)
# PDS_SERVICE_DID="did:web:your-pds.example.com"

# Blob upload limit (in bytes)
# PDS_BLOB_UPLOAD_LIMIT=52428800  # 50MB

# Port (default: 3000)
# PDS_PORT=3000

# ----------------------------------------------------------------------------
# ENTRYWAY (Optional - for managed hosting scenarios)
# ----------------------------------------------------------------------------

# If using an entryway for distributed PDS management
# PDS_ENTRYWAY_URL="https://entryway.example.com"
# PDS_ENTRYWAY_DID="did:web:entryway.example.com"
# PDS_ENTRYWAY_JWT_PUBLIC_KEY_K256_MULTIBASE="zQ3..."

# ----------------------------------------------------------------------------
# EXTERNAL SERVICES
# ----------------------------------------------------------------------------

# Blobstore configuration (defaults to local filesystem)
# PDS_BLOBSTORE_DISK_LOCATION="/pds/blobs"

# Or use S3:
# PDS_BLOBSTORE_S3_BUCKET="my-pds-blobs"
# PDS_BLOBSTORE_S3_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="..."
# AWS_SECRET_ACCESS_KEY="..."

# ----------------------------------------------------------------------------
# EMAIL (Optional - for account notifications)
# ----------------------------------------------------------------------------

# SMTP configuration
# PDS_EMAIL_SMTP_URL="smtps://user:pass@smtp.example.com:465"
# PDS_EMAIL_FROM_ADDRESS="noreply@your-pds.example.com"

# Or use AWS SES:
# PDS_EMAIL_AWS_REGION="us-east-1"
# AWS_ACCESS_KEY_ID="..."
# AWS_SECRET_ACCESS_KEY="..."

# ----------------------------------------------------------------------------
# DEBUGGING TIPS
# ----------------------------------------------------------------------------

# When logging to a file (LOG_DESTINATION is set):
#
# 1. Monitor logs in real-time:
#    tail -f /var/log/pds/oauth-debug.log
#
# 2. Filter logs by client ID:
#    grep "your-client-id" /var/log/pds/oauth-debug.log
#
# 3. Watch for DPoP errors:
#    grep "DPoP" /var/log/pds/oauth-debug.log
#
# 4. Check token operations:
#    grep "token" /var/log/pds/oauth-debug.log | grep -i "issue\|validate\|refresh"
#
# When logging to stdout (LOG_DESTINATION is not set):
#    View logs directly in your PDS output or use: docker logs <container-name>
#
# For less verbose logging in production:
#    LOG_LEVEL=info
#    LOG_SYSTEMS="pds:oauth"
