# ============================================================================
# PDS OAuth Debug Configuration - Local Testing
# ============================================================================

# ----------------------------------------------------------------------------
# OAUTH DEBUG LOGGING
# ----------------------------------------------------------------------------
LOG_ENABLED=true
LOG_LEVEL=debug

# OAuth-focused logging subsystems (comma-separated)
LOG_SYSTEMS="pds:oauth,pds:fetch,pds:db,pds:lexicon-resolver"

# ----------------------------------------------------------------------------
# DPOP CONFIGURATION
# ----------------------------------------------------------------------------

# DPoP secret for nonce generation (REQUIRED for DPoP)
PDS_DPOP_SECRET="6426eb678709c2b81ce0797ebb22f0bdaf00841c3aae2882743a28573899328f"

# ----------------------------------------------------------------------------
# REQUIRED PDS CONFIGURATION
# ----------------------------------------------------------------------------

# JWT secret for signing tokens
PDS_JWT_SECRET="T/M12pisQCbv/WG2tXBV7H2c7bYVHZOKp5MQCPpE32c="

# PLC rotation key (secp256k1 private key in hex)
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX="88da7752ec9856646004e64320ce3ad12753bdeff23714a2236a98a9e90dbf50"

# Admin password for PDS administration
PDS_ADMIN_PASSWORD="oauth-debug-admin-2024"

# Your PDS hostname (using localhost for local testing)
PDS_HOSTNAME="localhost"

# Service did (required for localhost)
PDS_SERVICE_DID="did:web:localhost"

# Enable dev mode for local testing (allows http://)
PDS_DEV_MODE=true

# Database connection (using absolute path for local SQLite)
PDS_DATA_DIRECTORY="/Users/joshlacalamito/Developer/atproto-oauth-debug/pds-data"

# Port
PDS_PORT=3000

# ----------------------------------------------------------------------------
# OAUTH CLIENT CONFIGURATION
# ----------------------------------------------------------------------------

# Optional: Trusted OAuth clients (comma or space-separated URLs)
# PDS_OAUTH_TRUSTED_CLIENTS=""

# ----------------------------------------------------------------------------
# BLOBSTORE
# ----------------------------------------------------------------------------

# Local filesystem for blobs (using absolute path)
PDS_BLOBSTORE_DISK_LOCATION="/Users/joshlacalamito/Developer/atproto-oauth-debug/pds-blobs"

# ----------------------------------------------------------------------------
# DEBUGGING TIPS
# ----------------------------------------------------------------------------

# Monitor logs: tail -f <log-file> or view stdout directly
# Filter by pattern: grep "DPoP" <log-file>
# For production, consider LOG_LEVEL=info and LOG_SYSTEMS="pds:oauth"
